# Copy this file to .env.local and fill in the values (Supabase → Project Settings → API Keys).
# .env.local is never pushed to GitHub; the same names are set in Vercel → Settings → Environment Variables.

# Supabase: safe for the browser (they only work within the database's security rules)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never start these with NEXT_PUBLIC_, never send them in chat):
# SUPABASE_SECRET_KEY=
# GUPSHUP_API_KEY=
